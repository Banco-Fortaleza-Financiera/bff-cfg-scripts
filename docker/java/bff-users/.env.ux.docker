SERVER_PORT=8080
APP_NAME=bff-ux-users

MANAGEMENT_ENDPOINTS_INCLUDE=health,info
MANAGEMENT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=always
MANAGEMENT_INFO_ENV_ENABLED=true

LOGGING_LEVEL_APP=info
LOGGING_LEVEL_SPRING_WEB=warn
LOGGING_PATTERN_CONSOLE=%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-no-request}] [%X{method:-} %X{path:-}] [%X{deviceIp:-unknown-ip}] %logger{36} - %msg%n

FEIGN_OKHTTP_ENABLED=true
FEIGN_CONNECT_TIMEOUT=3000
FEIGN_READ_TIMEOUT=5000
FEIGN_LOGGER_LEVEL=basic
CUSTOMER_PROFILE_URL=https://example.com

SUPPORT_SERVICE_NAME=support-service
SUPPORT_SERVICE_URL=http://bff-sp-users:9001

AUTH_SERVICE_NAME=auth-service
AUTH_SERVICE_URL=http://bff-sp-authentication:8888/support/v1
